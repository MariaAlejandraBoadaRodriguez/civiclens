# Copy to .env and fill in. Never commit .env.

# --- API (apps/api) ---
ENVIRONMENT=local
ALLOWED_ORIGINS=["http://localhost:3000"]
DEFAULT_LOCALE=en
# Writable working dir for uploads, demo files and Parquet layers (seed Parquet is read from data/seed)
# DATA_DIR=./data/runtime
# WARM_SEEDS=true
# Local Postgres from docker compose; Neon URL (postgresql+psycopg://...?sslmode=require) in prod.
DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens
# SENTRY_DSN=                                        # Phase 10
# One JSON log line per request, with request ID and locale (false = plain text)
# JSON_LOGS=true
# Public demo: anonymous writes allowed (false = every write needs a scoped API key)
# ANONYMOUS_WRITES=true
# Proxies in front of the API that append to X-Forwarded-For (Render: 1)
# TRUSTED_PROXY_HOPS=0
# Admin token shared with the web app (generate: openssl rand -hex 24). Unset = admin API off.
# ADMIN_API_TOKEN=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side calls from Next.js (defaults to NEXT_PUBLIC_API_URL)
API_URL=http://localhost:8000

# Admin console (/admin): Auth.js with GitHub OAuth, one allowlisted account.
# GitHub → Settings → Developer settings → OAuth Apps; callback URL:
#   http://localhost:3000/api/auth/callback/github
# GITHUB_ID=
# GITHUB_SECRET=
# ADMIN_GITHUB_LOGIN=your-github-login
# NEXTAUTH_SECRET=                                    # openssl rand -hex 32
# NEXTAUTH_URL=http://localhost:3000
# ADMIN_API_TOKEN=                                    # same value as the API's
# E2E only, never on Vercel: password-less sign-in as ADMIN_GITHUB_LOGIN
# ADMIN_TEST_LOGIN=true
