# Copy to .env and fill in. Never commit .env.

# --- API (apps/api) ---
ENVIRONMENT=local
ALLOWED_ORIGINS=["http://localhost:3000"]
DEFAULT_LOCALE=en
# Local Postgres from docker compose; Neon URL (postgresql+psycopg://...?sslmode=require) in prod.
DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens
# SENTRY_DSN=                                        # Phase 10

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
