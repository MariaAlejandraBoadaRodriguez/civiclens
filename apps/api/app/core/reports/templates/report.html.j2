<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t("reports.title") }} · {{ data.dataset.name }}</title>
<style>
  :root { --ink:#0f1b2d; --text:#1f2a37; --muted:#4b5563; --line:#d7dde4; --ground:#f4f6f8;
          --primary:#1d4ed8; --flag:#b45309; --flag-tint:#fdf1e4; --flag-text:#7c2d12; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--ground); color: var(--text);
         font: 15px/1.55 "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 860px; margin: 0 auto; padding: 32px 24px 48px; }
  header { border-bottom: 3px solid var(--ink); padding-bottom: 16px; margin-bottom: 24px; }
  h1 { margin: 0; font-size: 28px; color: var(--ink); }
  h2 { margin: 28px 0 10px; font-size: 18px; color: var(--ink); }
  .muted { color: var(--muted); font-size: 13px; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .tile { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 14px; }
  .tile .label { font-size: 13px; color: var(--muted); }
  .tile .value { font-size: 24px; font-weight: 600; color: var(--ink); margin-top: 4px; }
  .tile .def { font-size: 12px; color: var(--muted); margin-top: 6px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .finding { margin: 10px 0 0; font-weight: 500; }
  .warning { background: var(--flag-tint); color: var(--flag-text); border-radius: 10px; padding: 10px 14px; font-size: 14px; }
  svg { width: 100%; height: auto; }
  footer { margin-top: 32px; font-size: 12px; color: var(--muted); }
  @media print { body { background: #fff; } main { padding: 0; } .card, .tile { break-inside: avoid; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>{{ t("reports.title") }}</h1>
    <p class="muted">{{ t("reports.subtitle", dataset=data.dataset.name, date=date) }}</p>
  </header>

  <section aria-labelledby="summary">
    <h2 id="summary">{{ t("reports.summary.heading") }}</h2>
    <div class="card">
      <p style="margin:0">{{ texts.summary }}</p>
      <p style="margin:8px 0 0">{{ texts.quality }}</p>
    </div>
  </section>

  <section aria-labelledby="responsible">
    <h2 id="responsible">{{ responsible.heading }}</h2>
    <div class="warning">
      <ul style="margin:0;padding-left:18px">
        {% for item in responsible["items"] %}<li>{{ item }}</li>{% endfor %}
      </ul>
      <p style="margin:6px 0 0"><a href="{{ responsible.url }}" style="color:inherit">{{ responsible.guide }}</a>: {{ responsible.url }}</p>
    </div>
  </section>

  <section aria-labelledby="kpis">
    <h2 id="kpis">{{ t("reports.kpis.heading") }}</h2>
    <div class="tiles">
      {% for tile in tiles %}
      <div class="tile">
        <div class="label">{{ tile.name }}</div>
        <div class="value">{{ tile.value }}</div>
        <div class="def">{{ tile.definition }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="muted">{{ t("reports.kpis.currency_note") }}</p>
  </section>

  <section aria-labelledby="monthly">
    <h2 id="monthly">{{ t("reports.monthly.heading") }}</h2>
    <div class="card">
      {% if chart %}
      <svg viewBox="0 0 {{ chart.width }} {{ chart.height }}" role="img" aria-label="{{ texts.chart }}">
        <title>{{ texts.chart }}</title>
        <line x1="{{ chart.pad }}" x2="{{ chart.width - chart.pad }}" y1="{{ chart.height - chart.pad }}" y2="{{ chart.height - chart.pad }}" stroke="#d7dde4"/>
        <text x="{{ chart.pad }}" y="12" font-size="11" fill="#4b5563">{{ chart.top_label }}</text>
        {% for bar in chart.bars %}
        <rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.w }}" height="{{ bar.h }}" fill="{{ '#b45309' if bar.peak else '#1d4ed8' }}"><title>{{ bar.title }}</title></rect>
        {% if bar.label %}<text x="{{ bar.x }}" y="{{ chart.height - 8 }}" font-size="11" fill="#4b5563">{{ bar.label }}</text>{% endif %}
        {% endfor %}
      </svg>
      <p class="finding">{{ texts.finding }}</p>
      {% else %}
      <p style="margin:0">{{ t("reports.monthly.empty") }}</p>
      {% endif %}
    </div>
  </section>

  {% if suppliers %}
  <section aria-labelledby="suppliers">
    <h2 id="suppliers">{{ t("reports.suppliers.heading") }}</h2>
    <div class="card">
      <table>
        <thead><tr><th scope="col">{{ t("reports.suppliers.supplier") }}</th><th scope="col" class="num">{{ t("reports.suppliers.spend") }}</th><th scope="col" class="num">{{ t("reports.suppliers.share") }}</th></tr></thead>
        <tbody>
          {% for s in suppliers %}<tr><td>{{ s.name }}</td><td class="num">{{ s.spend }}</td><td class="num">{{ s.share }}</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  <section aria-labelledby="red-flags">
    <h2 id="red-flags">{{ t("reports.red_flags.heading") }}</h2>
    <div class="card">
      <p style="margin:0">{{ texts.red_flags if texts.red_flags else t("reports.red_flags.not_run") }}</p>
      <p class="warning" style="margin:10px 0 0">{{ t("reports.red_flags.warning") }}</p>
    </div>
  </section>

  <section aria-labelledby="forecast">
    <h2 id="forecast">{{ t("reports.forecast.heading") }}</h2>
    <div class="card">
      <p style="margin:0">{{ data.forecast.card.verdict if data.forecast and data.forecast.card.verdict else t("reports.forecast.not_run") }}</p>
    </div>
  </section>

  <section aria-labelledby="notes">
    <h2 id="notes">{{ t("reports.notes.heading") }}</h2>
    <ul class="muted">
      <li>{{ texts.source }}{% if data.dataset.source_url %} <a href="{{ data.dataset.source_url }}">{{ data.dataset.source_url }}</a>{% endif %}</li>
      <li>{{ t("reports.notes.fx", source=data.fx_source) }}</li>
      <li>{{ t("reports.notes.values") }}</li>
    </ul>
  </section>

  <footer>{{ t("reports.footer", date=date) }}</footer>
</main>
</body>
</html>
